@model ShoeStore.Controllers.HomeViewModel
@{
    ViewData["Title"] = "Обувной магазин - Главная";
}

<div class="container mt-4">
    <h1 class="text-center mb-5">Популярные товары</h1>

    <!-- Карточки товаров -->
    <div class="row">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <!-- Бейджи (Новинка, Скидка) -->
                    <div class="position-absolute" style="top: 10px; left: 10px; z-index: 1;">
                        @if (product.IsNew)
                        {
                            <span class="badge bg-success">Новинка</span>
                        }
                        @if (product.IsSale)
                        {
                            <span class="badge bg-danger">Скидка</span>
                        }
                    </div>

                    <!-- Изображение товара -->
                    <div class="card-img-top" style="height: 200px; overflow: hidden;">
                        <img src="@product.ImageUrl"
                             alt="@product.Name"
                             class="img-fluid"
                             style="width: 100%; height: 100%; object-fit: cover;">
                    </div>

                    <!-- Тело карточки -->
                    <div class="card-body d-flex flex-column">
                        <!-- Бренд -->
                        <small class="text-muted">@product.Brand</small>

                        <!-- Название -->
                        <h5 class="card-title">@product.Name</h5>

                        <!-- Описание -->
                        <p class="card-text flex-grow-1">@product.Description</p>

                        <!-- Рейтинг -->
                        <div class="mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= product.Rating)
                                {
                                    <span class="text-warning">★</span>
                                }
                                else
                                {
                                    <span class="text-secondary">★</span>
                                }
                            }
                            <span class="small text-muted">(@product.Rating.ToString("0.0"))</span>
                        </div>

                        <!-- Размеры -->
                        <div class="mb-3">
                            <small class="text-muted">Размеры:</small>
                            <div>
                                @foreach (var size in product.AvailableSizes.Take(5))
                                {
                                    <span class="badge bg-light text-dark border me-1">@size</span>
                                }
                                @if (product.AvailableSizes.Count > 5)
                                {
                                    <span class="badge bg-light text-dark border">...</span>
                                }
                            </div>
                        </div>

                        <!-- Цена -->
                        <div class="mt-auto">
                            @if (product.OldPrice.HasValue)
                            {
                                <div>
                                    <span class="text-muted text-decoration-line-through">
                                        @product.OldPrice.Value.ToString("N0") ₽
                                    </span>
                                    <span class="h5 text-danger ms-2">
                                        @product.Price.ToString("N0") ₽
                                    </span>
                                </div>
                            }
                            else
                            {
                                <h5 class="text-primary">@product.Price.ToString("N0") ₽</h5>
                            }
                        </div>
                    </div>

                    <!-- Кнопки действий -->
                    <div class="card-footer bg-white border-top-0">
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-add-to-cart"
                                    data-product-id="@product.Id">
                                <i class="bi bi-cart-plus"></i> В корзину
                            </button>
                            <button class="btn btn-outline-secondary btn-quick-view"
                                    data-product-id="@product.Id">
                                <i class="bi bi-eye"></i> Быстрый просмотр
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Секция "Новинки" -->
    @if (Model.NewArrivals.Any())
    {
        <div class="mt-5 pt-5 border-top">
            <h2 class="text-center mb-4">Новинки</h2>
            <div class="row">
                @foreach (var product in Model.NewArrivals)
                {
                    <div class="col-md-4 mb-4">
                        <!-- Упрощенная карточка для новинок -->
                        <div class="card">
                            <!-- аналогичная структура, можно упростить -->
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Стили -->
<style>
    .card {
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid #e0e0e0;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .card-img-top {
        background-color: #f8f9fa;
    }

    .btn-add-to-cart {
        transition: all 0.3s;
    }

    .btn-add-to-cart:hover {
        background-color: #0056b3;
        transform: scale(1.02);
    }

    .badge {
        font-size: 0.75em;
    }
</style>

<!-- JavaScript для обработки кликов -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // Добавление в корзину
            $('.btn-add-to-cart').click(function() {
                const productId = $(this).data('product-id');
                addToCart(productId);
            });

            // Быстрый просмотр
            $('.btn-quick-view').click(function() {
                const productId = $(this).data('product-id');
                quickView(productId);
            });

            function addToCart(productId) {
                // AJAX запрос для добавления в корзину
                $.post('/Cart/Add', { productId: productId })
                    .done(function(response) {
                        // Показать уведомление
                        showNotification('Товар добавлен в корзину!', 'success');

                        // Обновить счетчик корзины
                        updateCartCount();
                    })
                    .fail(function() {
                        showNotification('Ошибка при добавлении товара', 'error');
                    });
            }

            function quickView(productId) {
                // Открыть модальное окно с деталями товара
                $.get('/Product/QuickView/' + productId, function(data) {
                    $('#quickViewModal .modal-body').html(data);
                    $('#quickViewModal').modal('show');
                });
            }

            function showNotification(message, type) {
                // Реализация уведомления
                // Можно использовать toast или sweetalert
            }

            function updateCartCount() {
                // Обновить счетчик товаров в корзине
            }
        });
    </script>
}